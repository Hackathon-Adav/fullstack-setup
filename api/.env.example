# PostgreSQL — nom du service "db" dans compose.yaml
DATABASE_URL=postgresql://app:app@db:5432/app

# Port de l'API (optionnel, 3000 par défaut)
PORT=3000

# Fournisseur IA — Ollama local par défaut
# macOS / Windows : host.docker.internal
# Linux          : ajoutez extra_hosts dans compose.yaml (déjà fait) et gardez cette URL
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=